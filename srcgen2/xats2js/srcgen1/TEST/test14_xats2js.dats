(* ****** ****** *)
(* ****** ****** *)
//
fun
test_expected_solution(): void =
let
  val actual =
    eight_queens()

  val expected =
    list_make_3val<int>(0, 4, 7)

  val expected =
    list_extend<int>(expected, 5)

  val expected =
    list_extend<int>(expected, 2)

  val expected =
    list_extend<int>(expected, 6)

  val expected =
    list_extend<int>(expected, 1)

  val expected =
    list_extend<int>(expected, 3)

  val ok =
    list_equal<int>(actual, expected)
(*    
  val () =
  printsln("test_expected: actual = ", actual)
  val () =
  printsln("test_expected: expected = ", expected)
*)
in
  if ok
  then
  printsln("test_expected_solution: PASS")
  else
  printsln("test_expected_solution: FAIL")
end
//
(* ****** ****** *)
//
fun
test_validity(): void =
let
  val solution =
    eight_queens()

  val ok =
    verify_solution(solution)
in
  if ok
  then printsln("test_validity: PASS")
  else printsln("test_validity: FAIL")
end
//
(* ****** ****** *)
//
fun
test_known_solution(): void =
let
  val solution =
    list_make_3val<int>(0, 4, 7)

  val solution =
    list_extend<int>(solution, 5)

  val solution =
    list_extend<int>(solution, 2)

  val solution =
    list_extend<int>(solution, 6)

  val solution =
    list_extend<int>(solution, 1)

  val solution =
    list_extend<int>(solution, 3)

  val ok =
    verify_solution(solution)
in
  if ok
  then printsln("test_known_solution: PASS")
  else printsln("test_known_solution: FAIL")
end
