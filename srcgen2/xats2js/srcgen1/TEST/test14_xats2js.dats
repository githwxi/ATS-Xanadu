(*
** ATS3 / ATS-Xanadu
**
** All solutions to the 8-queens problem as a lazy linear stream.
**
** A solution is represented as:
**
**   [c0,c1,c2,c3,c4,c5,c6,c7]
**
** where ci is the column occupied by the queen in row i.
**
** Columns are tried from 0 through 7, so solutions are generated
** in lexicographic order of their column representations.
*)
(* ****** ****** *)
(* Is a proposed queen position safe? *)
(* ****** ****** *)
//
fun
queen_safe
(
  row: int,
  col: int,
  qs: list(int)
) : bool =
let
  fun
  loop
  (
    r: int,
    qs: list(int)
  ) : bool =
  (
    case+ qs of
    | list_nil() => true
    | list_cons(q, qs) =>
        let
          val dr = r + 1
          // HX-2026-08-22:
          // ChatGPT error!!!
          // val dr = row - r
          val dc =
            if col >= q
            then col - q else q - col
        in
          if // if
          (col = q)
          then false
          else if (dr = dc) then false else loop(r + 1, qs)
        end
  )
in
  loop(0, qs)
end
//
(* ****** ****** *)
(* Generate all solutions from a given row. *)
(* ****** ****** *)
//
fun
eight_queens
(): list(int) =
let
  (*
  ** [solve_row row qs]
  **
  ** [qs] contains the columns selected for rows
  ** 0 .. row-1.
  **
  ** We try columns from 0 through 7.  Consequently,
  ** the first solution is deterministic.
  *)
  fun
  solve_row
  (
    row: int,
    qs: list(int)
  ): list(int) =
  (
    if row = 8
    then
      list_reverse<int>(qs)
    else
      try_col(row, 0, qs)
  )
  (*
  ** Try each possible column in the current row.
  *)
  and
  try_col
  (
    row: int,
    col: int,
    qs: list(int)
  ): list(int) =
    if col = 8
    then
      list_nil<int>()
    else
      if queen_safe(row, col, qs)
      then
        let
          val qs1 =
            list_cons<int>(col, qs)

          val result =
            solve_row(row + 1, qs1)
        in
          case+ result of
          | list_nil() =>
              try_col(row, col + 1, qs)

          | list_cons(_, _) =>
              result
        end
      else
        try_col(row, col + 1, qs)
in
  solve_row(0, list_nil<int>())
end
//
(* ****** ****** *)
(* ****** ****** *)
//
fun
verify_solution
(
  qs: list(int)
): bool =
let
  fun
  loop
  (
    row: int,
    qs: list(int)
  ): bool =
    case+ qs of
    | list_nil() =>
        row = 8
    | list_cons(col, qs) =>
      (
        if col < 0 then false else
        if col >= 8 then false else
        if queen_safe(row, col, qs) then loop(row + 1, qs) else false
      )
in
  loop(0, qs)
end
