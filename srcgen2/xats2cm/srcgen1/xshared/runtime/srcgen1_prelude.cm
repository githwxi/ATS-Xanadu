  (XATS2CM_gflt_pre$dflt x0) (- x0 1.0))
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
  (XATS2CM_gflt_lt$dflt$dflt x1 x2)
