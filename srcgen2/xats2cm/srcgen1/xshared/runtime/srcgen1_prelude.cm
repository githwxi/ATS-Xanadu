;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;.
;;
(define
  (XATS2CM_gflt_add$dflt$dflt x1 x2)
  (+ x1 x2)) ;; dflt_add$dflt(x1, x2)
