########################################################################
########################################################################
# Makefile for bootstrapping
########################################################################
########################################################################
CAT=cat
SED=sed
ECHO=echo
NODE=node
PRINTF=printf
########################################################################
SRCGEN2=./../../../../srcgen2
XATSJSD=./../../../../srcgen2/xats2js
XATSCMD=./../../../../srcgen2/xats2cm
########################################################################
S2XSHRD=\
$(SRCGEN2)/xats2cm/srcgenx/xshared/runtime
########################################################################
########################################################################
#
all:: \
xats2cm_cmemit00
xats2cm_cmemit00: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm1\1tnm/g' \
$(SRCGEN2)/lib/lib2xatsopt.cm | $(CAT) - >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm2\1tnm/g' \
$(XATSJSD)/srcgen1/lib/lib2xats2js.cm | $(CAT) - >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm3\1tnm/g' \
$(XATSCMD)/srcgen1/lib/lib2xats2cm.cm | $(CAT) - >> $@_ats3.cm && \
$(NODE) \
  --stack-size=8192 $(XATS2CM_CMEMIT00) xats2cm_cmemit00.dats >> $@_ats3.cm
#
all:: \
xats2cm_cmemit01
xats2cm_cmemit01: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm1\1tnm/g' \
$(SRCGEN2)/lib/lib2xatsopt.cm | $(CAT) - >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm2\1tnm/g' \
$(XATSJSD)/srcgen1/lib/lib2xats2js.cm | $(CAT) - >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm3\1tnm/g' \
$(XATSCMD)/srcgen1/lib/lib2xats2cm.cm | $(CAT) - >> $@_ats3.cm && \
$(NODE) \
  --stack-size=8192 $(XATS2CM_CMEMIT00) xats2cm_cmemit01.dats >> $@_ats3.cm
#
xats2cm_cmemit00_opt0: ; \
$(SED) '/^[ ]*;;/d' xats2cm_cmemit00_ats3.cm > xats2cm_cmemit00_ats3_opt0.cm
#
xats2cm_cmemit01_opt0: ; \
$(SED) '/^[ ]*;;/d' xats2cm_cmemit01_ats3.cm > xats2cm_cmemit01_ats3_opt0.cm
#
########################################################################
########################################################################
clean:: ; rm -f *~
cleanall:: ; rm -f *~
########################################################################
cleanall:: ; \
rm -f xats2cm_cmemit00_ats3.cm
cleanall:: ; \
rm -f xats2cm_cmemit01_ats3.cm
########################################################################
########################################################################
XASSETS=\
./../../../../xassets
########################################################################
ifndef XATSOPT_TCHECK00
XATSOPT_TCHECK00=$(XASSETS)/JS/xatsopt/xatsopt_tcheck00_ats2_opt1.js
endif ## (ifeq($(XATSOPT_TCHECK00),""))
########################################################################
ifndef XATS2CM_CMEMIT00
XATS2CM_CMEMIT00=$(XASSETS)/JS/xats2cm/xats2cm_cmemit00_ats2_opt1.js
endif ## (ifeq($(XATS2CM_CMEMIT00),""))
########################################################################
########################################################################
###################### end of [Makefile_xcmemit] #######################
