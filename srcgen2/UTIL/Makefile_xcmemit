########################################################################
########################################################################
# Makefile for bootstrapping
########################################################################
########################################################################
CAT=cat
SED=sed
ECHO=echo
NODE=node
########################################################################
SRCGEN2=./../../srcgen2
########################################################################
S2XSHRD=\
$(SRCGEN2)/xats2cm/srcgenx/xshared/runtime
########################################################################
########################################################################
#
all:: \
xatsopt_tcheck00
xatsopt_tcheck00: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm1\1tnm/g' \
$(SRCGEN2)/lib/lib2xatsopt.cm | $(CAT) - >> $@_ats3.cm && \
$(NODE) \
  --stack-size=8801 $(XATS2CM_CMEMIT00) xatsopt_tcheck00.dats >> $@_ats3.cm
#
all:: \
xatsopt_tcheck01
xatsopt_tcheck01: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(SED) -E 's/cmx(...)tnm/cm1\1tnm/g' \
$(SRCGEN2)/lib/lib2xatsopt.cm | $(CAT) - >> $@_ats3.cm && \
$(NODE) \
  --stack-size=8801 $(XATS2CM_CMEMIT00) xatsopt_tcheck01.dats >> $@_ats3.cm
#
########################################################################
########################################################################
#
xatsopt_tcheck00_opt0: ; \
$(SED) '/^[ ]*##/d' xatsopt_tcheck00_ats3.cm > xatsopt_tcheck00_ats3_opt0.cm
xatsopt_tcheck01_opt0: ; \
$(SED) '/^[ ]*##/d' xatsopt_tcheck01_ats3.cm > xatsopt_tcheck01_ats3_opt0.cm
#
########################################################################
########################################################################
clean:: ; rm -f *~
cleanall:: ; rm -f *~
########################################################################
cleanall:: ; \
rm -f xatsopt_tcheck00_ats3.cm
cleanall:: ; \
rm -f xatsopt_tcheck01_ats3.cm
########################################################################
########################################################################
XASSETS=./../../xassets
########################################################################
ifndef XATS2CM_CMEMIT00
XATS2CM_CMEMIT00=$(XASSETS)/JS/xats2cm/xats2cm_cmemit00_ats2_opt1.js
endif ## (ifeq($(XATS2CM_CMEMIT00),""))
