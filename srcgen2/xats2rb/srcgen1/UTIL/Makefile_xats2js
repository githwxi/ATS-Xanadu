########################################################################
#
# HX-2026-10-20:
# For compiling
# xats2rb_rbemit01 to JavaScript
# The compiler is srcgen1/xats2js
# which does perform tail-recursive
# call optimization!
#
########################################################################
CAT=cat
CPF=cp -f
ECHO=echo
# NODE=node
# NODE=node \
# --stack-size=8801
# NODE=node \
# --stack-size=8801 \
# --max-old-space-size=8801
########################################################################
XSHARED=${XATSJSD}/xshared
XATS2JS=${XATSJSD}/bin/xats2js
########################################################################
XATSJSD=\
$(XATSHOME)/srcgen1/xats2js/srcgenx
########################################################################
LIBXATS2RB_JS="./../lib/lib1xats2rb.js"
LIBXATSOPT_JS="./../../../lib/lib1xatsopt.js"
LIBXATS2JS_JS=\
"./../../../xats2js/srcgenx/lib/lib1xats2js.js"
########################################################################
XATS2JS_JS1EMIT="$(XSHARED)/runtime/xats2js_js1emit.js"
SRCGEN1_PRECATS="$(XSHARED)/runtime/srcgen1_precats.js"
SRCGEN1_PRELUDE="$(XSHARED)/runtime/srcgen1_prelude.js"
SRCGEN1_PRELUDE_NODE="$(XSHARED)/runtime/srcgen1_prelude_node.js"
SRCGEN1_XATSLIB_NODE="$(XSHARED)/runtime/srcgen1_xatslib_node.js"
########################################################################
#
all:: \
xats2rb_rbemit01
xats2rb_rbemit01:: \
xats2rb_rbemit01.dats ; \
$(CAT) \
$(XATS2JS_JS1EMIT) > $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRECATS) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRELUDE) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRELUDE_NODE) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_XATSLIB_NODE) >> $@_ats2.js && \
$(CAT) $(LIBXATSOPT_JS) >> $@_ats2.js && \
$(CAT) $(LIBXATS2JS_JS) >> $@_ats2.js && \
$(CAT) $(LIBXATS2RB_JS) >> $@_ats2.js && \
$(XATS2JS) --output-a $@_ats2.js --dynamic $@.dats
#
xats2rb_rbemit01_opt1: ; \
npx google-closure-compiler \
  -W QUIET --compilation_level SIMPLE \
  --js=xats2rb_rbemit01_ats2.js --js_output_file=xats2rb_rbemit01_ats2_opt1.js
#
########################################################################
#
lib1xatsopt2js2rb: ; \
$(CAT) \
$(XATS2JS_JS1EMIT) > $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRECATS) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRELUDE) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_PRELUDE_NODE) >> $@_ats2.js && \
$(CAT) \
$(SRCGEN1_XATSLIB_NODE) >> $@_ats2.js && \
$(CAT) $(LIBXATSOPT_JS) >> $@_ats2.js && \
$(CAT) $(LIBXATS2JS_JS) >> $@_ats2.js && \
$(CAT) $(LIBXATS2RB_JS) >> $@_ats2.js && \
$(CAT) $(LIBXATSOPT_JS) $(LIBXATS2JS_JS) $(LIBXATS2RB_JS) >> $@_ats2.js
#
lib1xatsopt2js2rb_opt1: ; \
npx google-closure-compiler \
  -W QUIET --compilation_level SIMPLE \
  --js=lib1xatsopt2js2rb_ats2.js --js_output_file=lib1xatsopt2js2rb_ats2_opt1.js
#
########################################################################
#
# HX: for cleaning up
#
clean:: ; rm -f *~
#
cleanall:: clean
cleanall:: ; rm -f ./xats2rb_rbemit0?_ats2.js
cleanall:: ; rm -f ./xats2rb_rbemit0?_ats2_opt1.js
cleanall:: ; rm -f ./lib1xatsopt2js2rb_ats2.js
cleanall:: ; rm -f ./lib1xatsopt2js2rb_ats2_opt1.js
#
########################################################################
########################################################################
###################### end of [Makefile_xats2js] #######################
