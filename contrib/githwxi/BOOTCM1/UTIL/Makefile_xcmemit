# Makefile for bootstrapping
########################################################################
########################################################################
CAT=cat
ECHO=echo
NODE=node
########################################################################
BOOTCM1=./..
########################################################################
SRCGEN2=./../../../../srcgen2
XATS2CM=./../../../../srcgen2/xats2cm
########################################################################
S2XSHRD=\
$(SRCGEN2)/xats2cm/srcgenx/xshared/runtime
########################################################################
########################################################################
#
all:: \
xatsopt_tcheck00
xatsopt_tcheck00: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(CAT) $(BOOTCM1)/lib/lib2xatsopt.cm >> $@_ats3.cm && \
$(NODE) --stack-size=8192 \
$(XATS2CM_CMEMIT00) $(SRCGEN2)/UTIL/xatsopt_tcheck00.dats >> $@_ats3.cm
#
all:: \
xatsopt_tcheck01
xatsopt_tcheck01: ; \
printf ";; %s\n" "`date`" > $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/xats2cm_cm1emit.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_prelude.cm >> $@_ats3.cm && \
$(CAT) \
$(S2XSHRD)/srcgen1_xatslib.cm >> $@_ats3.cm && \
$(CAT) $(BOOTCM1)/lib/lib2xatsopt.cm >> $@_ats3.cm && \
$(NODE) --stack-size=8192 \
$(XATS2CM_CMEMIT00) $(SRCGEN2)/UTIL/xatsopt_tcheck01.dats >> $@_ats3.cm
#
########################################################################
########################################################################
clean:: ; rm -f *~
cleanall:: ; rm -f *~
########################################################################
cleanall:: ; rm -f xatsopt_tcheck00_ats3.cm
