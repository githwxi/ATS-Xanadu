AR=ar
CP=cp
MV=mv
CC=gcc
SED=sed
CPF=cp -f
MVF=mv -f
RMF=rm -f
WCL=wc -l
########################################################################
CAT=cat
CPF=cp -f
ECHO=echo
NODE=node
NODE=node --stack-size=4096
######
XSHARED="${XATSJSD}/xshared"
######
SRCGEN1=./../../../../../srcgen1
SRCGEN2=./../../../../../srcgen2
######
XATSJSD=\
$(SRCGEN1)/srcgen1/xats2js/srcgen1
########################################################################
#
XATS2JS=\
./../../../srcgen1/xats2js/srcgen1/bin/xats2js
#
# XATS2JS=\
# nix run \
# github:GZGavinZhao/ATS-Xanadu/nixify\#xats2js \
# --extra-experimental-features flakes --extra-experimental-features nix-command --
#
########################################################################

SRCSATS := \
xats2cm.sats \
cm1emit.sats \

######

SRCDATS := \
xats2cm.dats \
xats2cm_dynexp.dats \
xats2cm_decl00.dats \
cm1emit.dats \
cm1emit_utils0.dats \
cm1emit_dynexp.dats \
cm1emit_decl00.dats \

########################################################################
########################################################################
OBJSATS := \
$(patsubst %.sats, BUILD/JS/%_sats.js, $(SRCSATS))
OBJDATS := \
$(patsubst %.dats, BUILD/JS/%_dats.js, $(SRCDATS))
########################################################################
########################################################################
all:: $(OBJDATS)
########################################################################
cleanall:: ; rm -f BUILD/JS/*_dats.js
########################################################################
libxats2cm:: \
$(OBJDATS); $(CAT) $(OBJDATS) > lib/libxats2cm.js
########################################################################
XATS2CM_SRCGEN1=$(SRCGEN2)/xats2cm/srcgen1
########################################################################
BUILD/JS/%_dats.js: \
$(XATS2CM_SRCGEN1)/DATS/%.dats; $(XATS2JS) --output-w $@ --dynamic $<
